# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# workspace
*.code-workspace

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude/
.env

# personal / non-app materials — keep the loop's working tree clean
.copilot/
docs/
output/
tasks/
scripts/inspect_deck.py
scripts/pitch_deck.py
scripts/pitch_deck_v4.py
scripts/pitch_deck_v5.py
scripts/pitch_deck_v6.py
